/* Fragment 51 -> &tlmm */
&tlmm {

	bq25890_int_default: bq25890_int_default {

		config {
			bias-pull-up;
			drive-strength = <0x02>;
			input-enable;
			pins = "gpio99";
		};

		mux {
			function = "gpio";
			pins = "gpio99";
		};

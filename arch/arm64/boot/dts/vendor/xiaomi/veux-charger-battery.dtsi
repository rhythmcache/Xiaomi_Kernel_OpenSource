/* Xiaomi Poco X4 Pro 5G (veux) - Charger-battery Subsystem */

/* Fragment 39 -> &tlmm */
&tlmm {

	sc8551_int2_default: sc8551_int2_default {

		config {
			bias-pull-up;
			drive-strength = <0x02>;
			input-enable;
			pins = "gpio38";
		};

		mux {
			function = "gpio";
			pins = "gpio38";
		};
	};

	sc8551_int_default: sc8551_int_default {

		config {
			bias-pull-up;
			drive-strength = <0x02>;
			input-enable;
			pins = "gpio87";
		};

		mux {
			function = "gpio";
			pins = "gpio87";
		};
	};
};

/* Fragment 40 -> &qupv3_se10_i2c */
&qupv3_se10_i2c {
	#address-cells = <0x01>;
	#size-cells = <0x00>;
	status = "ok";

	/* Southchip SC8551 67W Turbo Charge pump (Master) at I2C address 0x66 */
sc8551_master: sc8551-charger@66 {
		#io-channel-cells = <0x01>;
		compatible = "sc,sc8551-master";
		interrupt-parent = <&tlmm>;
		interrupts = <0x57 0x00>;
		pinctrl-0 = <&sc8551_int_default>;
		pinctrl-names = "default";
		reg = <0x66>;
		sc,sc8551,ac-ovp-threshold = <0x0d>;
		sc,sc8551,bat-ocp-alarm-threshold = <0x1d4c>;
		sc,sc8551,bat-ocp-threshold = <0x1f40>;
		sc,sc8551,bat-ovp-alarm-threshold = <0x1130>;
		sc,sc8551,bat-ovp-threshold = <0x11df>;
		sc,sc8551,bat-therm-disable = <0x00>;
		sc,sc8551,bat-therm-threshold = <0x15>;
		sc,sc8551,bat-ucp-alarm-threshold = <0x7d0>;
		sc,sc8551,bus-ocp-alarm-threshold = <0xdac>;
		sc,sc8551,bus-ocp-threshold = <0xea6>;
		sc,sc8551,bus-ovp-alarm-threshold = <0x2af8>;
		sc,sc8551,bus-ovp-threshold = <0x2ee0>;
		sc,sc8551,bus-therm-disable = <0x00>;
		sc,sc8551,bus-therm-threshold = <0x15>;
		sc,sc8551,die-therm-threshold = <0x7d>;
		sc,sc8551,sense-resistor-mohm = <0x05>;
	};
};

/* Fragment 41 -> &qupv3_se0_i2c */
&qupv3_se0_i2c {
	#address-cells = <0x01>;
	#size-cells = <0x00>;
	status = "ok";

	/* Southchip SC8551 Charge pump (Slave) at I2C address 0x66 */
sc8551_slave: sc8551-charger@66 {
		#io-channel-cells = <0x01>;
		compatible = "sc,sc8551-slave";
		inctrl-0 = <&sc8551_int2_default>;
		interrupt-parent = <&tlmm>;
		interrupts = <0x26 0x00>;
		pinctrl-names = "default";
		reg = <0x66>;
		sc,sc8551,ac-ovp-threshold = <0x0d>;
		sc,sc8551,bat-ocp-alarm-threshold = <0x1d4c>;
		sc,sc8551,bat-ocp-threshold = <0x1f40>;
		sc,sc8551,bat-ovp-alarm-threshold = <0x1130>;
		sc,sc8551,bat-ovp-threshold = <0x11df>;
		sc,sc8551,bat-therm-disable = <0x00>;
		sc,sc8551,bat-therm-threshold = <0x15>;
		sc,sc8551,bat-ucp-alarm-threshold = <0x7d0>;
		sc,sc8551,bus-ocp-alarm-threshold = <0xdac>;
		sc,sc8551,bus-ocp-threshold = <0xea6>;
		sc,sc8551,bus-ovp-alarm-threshold = <0x2af8>;
		sc,sc8551,bus-ovp-threshold = <0x2ee0>;
		sc,sc8551,bus-therm-disable = <0x00>;
		sc,sc8551,bus-therm-threshold = <0x15>;
		sc,sc8551,die-therm-threshold = <0x7d>;
		sc,sc8551,sense-resistor-mohm = <0x05>;
	};
};


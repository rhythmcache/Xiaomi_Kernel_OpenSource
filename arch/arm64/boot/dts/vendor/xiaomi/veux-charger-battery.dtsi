};

/* Fragment 53 -> &qupv3_se0_i2c */
&qupv3_se0_i2c {
	#address-cells = <0x01>;
	#size-cells = <0x00>;
	status = "ok";

	/* Texas Instruments BQ27Z561 fuel gauge at I2C address 0x55 */
bq27z561_qg: bq27z561@55 {
		#io-channel-cells = <0x01>;
		bq,shutdown-delay-enable;
		bq,soc_decimal_rate = <0x00 0x20 0x0a 0x1e 0x14 0x1c 0x1e 0x1c 0x28 0x1c 0x32 0x1c 0x3c 0x1c 0x46 0x1c 0x50 0x1c 0x5a 0x1a 0x5f 0x0a 0x63 0x05>;
		compatible = "bq27z561";
		reg = <0x55>;
	};
};

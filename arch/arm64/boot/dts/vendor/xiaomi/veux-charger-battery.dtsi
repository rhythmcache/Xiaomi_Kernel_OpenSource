/* Fragment 43 -> &qupv3_se10_i2c */
&qupv3_se10_i2c {
	#address-cells = <0x01>;
	#size-cells = <0x00>;
	status = "ok";

	/* Lion Semiconductor LN8000 switched-capacitor fast charger (Master) at I2C 0x51 */
ln8000_master: ln8000-charger@51 {
		#io-channel-cells = <0x01>;
		compatible = "lionsemi,ln8000";
		interrupt-parent = <&tlmm>;
		interrupts = <0x57 0x00>;
		ln8000_charger,ac-ovp-threshold = <0x0d>;
		ln8000_charger,bat-ocp-alarm-threshold = <0x1d4c>;
		ln8000_charger,bat-ocp-threshold = <0x1f40>;
		ln8000_charger,bat-ovp-alarm-threshold = <0x1130>;
		ln8000_charger,bat-ovp-threshold = <0x11df>;
		ln8000_charger,bat-therm-disable = <0x00>;
		ln8000_charger,bat-therm-threshold = <0x15>;
		ln8000_charger,bat-ucp-alarm-threshold = <0x7d0>;
		ln8000_charger,bus-ocp-alarm-threshold = <0xdac>;
		ln8000_charger,bus-ocp-threshold = <0xea6>;
		ln8000_charger,bus-ovp-alarm-threshold = <0x2af8>;
		ln8000_charger,bus-ovp-threshold = <0x3200>;
		ln8000_charger,bus-therm-disable = <0x00>;
		ln8000_charger,bus-therm-threshold = <0x15>;
		ln8000_charger,die-therm-threshold = <0x7d>;
		ln8000_charger,iin-reg-disable;
		ln8000_charger,revcurr-prot-disable;
		ln8000_charger,sense-resistor-mohm = <0x05>;
		ln8000_charger,tbat-mon-disable;
		ln8000_charger,tbus-mon-disable;
		ln8000_charger,tdie-prot-disable;
		ln8000_charger,tdie-reg-disable;
		ln8000_charger,vbat-reg-disable;
		pinctrl-0 = <&ln8000_int_default>;
		pinctrl-names = "default";
		reg = <0x51>;
	};
};


/* Fragment 63 -> &thermal_zones */
&thermal_zones {

	/* Thermal sensor zone for fast charging circuit temperature monitoring */
	charge-main-usr {
		polling-delay = <0x00>;
		polling-delay-passive = <0x00>;
		thermal-governor = "user_space";
		thermal-sensors = <&pmk8350_adc_tm>, <0x645>;
		wake-capable-sensor;

		trips {

			active-config0 {
				hysteresis = <0x3e8>;
				temperature = <0x1e848>;
				type = "passive";
			};
		};
	};

	charge-slave-usr {
		polling-delay = <0x00>;
		polling-delay-passive = <0x00>;

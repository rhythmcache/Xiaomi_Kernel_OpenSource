	xo-therm-step {
		disable-thermal-zone;
		polling-delay = <0x00>;
		polling-delay-passive = <0x00>;
		status = "disabled";
		thermal-governor = "step_wise";
		thermal-sensors = <&pmk8350_adc_tm>, <0x644>;

		cooling-maps {

			modem_pa_fr1_cdev0 {
				cooling-device = <&modem_pa_fr1>, <0x01 0x01>;
				trip = <&modem_pa_fr1_trip0>;
			};

			modem_pa_fr1_cdev1 {
				cooling-device = <&modem_pa_fr1>, <0x02 0x02>;
				trip = <&modem_pa_fr1_trip1>;
			};

			modem_pa_fr1_cdev2 {
				cooling-device = <&modem_pa_fr1>, <0x03 0x03>;
				trip = <&modem_pa_fr1_trip2>;
			};
		};

		trips {

			modem_pa_fr1_trip0: modem-pa-fr1-trip0 {
				hysteresis = <0xfa0>;
				temperature = <0xafc8>;
				type = "passive";
			};

			modem_pa_fr1_trip1: modem-pa-fr1-trip1 {
				hysteresis = <0xfa0>;
				temperature = <0xb3b0>;
				type = "passive";
			};

			modem_pa_fr1_trip2: modem-pa-fr1-trip2 {

				trip = <&modem_trip1>;
			};

			modem-cdev2 {
				cooling-device = <&modem_pa>, <0x03 0x03>;
				trip = <&modem_trip2>;
			};
		};

		trips {

			modem_trip0: modem-trip0 {
				hysteresis = <0xfa0>;
				temperature = <0xb3b0>;
				type = "passive";
			};

			modem_trip1: modem-trip1 {
				hysteresis = <0xfa0>;
				temperature = <0xb798>;
				type = "passive";
			};

			modem_trip2: modem-trip2 {
				hysteresis = <0xfa0>;
				temperature = <0xd2f0>;
				type = "passive";
			};
		};
	};

	quiet-therm-step {
		disable-thermal-zone;
		polling-delay = <0x00>;
		polling-delay-passive = <0x7d0>;
		status = "disabled";
		thermal-governor = "step_wise";
		thermal-sensors = <&pm6125_adc_tm>, <0x4e>;

		cooling-maps {

			cdsp-cdev {
				cooling-device = <&cdsp_sw>, <0x04 0x04>;
				trip = <&cx_trip>;
			};

			gold-cdev {
				cooling-device = <&CPU6>, <0xfffffff9 0xfffffff9>;
				trip = <&gold_trip>;
			};

			gpu-cdev0 {
				cooling-device = <&msm_gpu>, <0xfffffffa 0xfffffffa>;
				trip = <&modem_skin_trip1>;
			};

			gpu-cdev1 {
				cooling-device = <&msm_gpu>, <0xfffffffb 0xfffffffb>;
				trip = <&cx_trip>;
			};

			modem-skin-cdev0 {

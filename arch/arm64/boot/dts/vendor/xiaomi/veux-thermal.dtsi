		};
	};

	pa-therm0-step {
		disable-thermal-zone;
		polling-delay = <0x00>;
		polling-delay-passive = <0x00>;
		status = "disabled";
		thermal-governor = "step_wise";
		thermal-sensors = <&pm6125_adc_tm>, <0x4d>;

		cooling-maps {

			modem-cdev0 {
				cooling-device = <&modem_pa>, <0x01 0x01>;

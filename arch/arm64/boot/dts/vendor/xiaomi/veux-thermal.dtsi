				temperature = <0xb3b0>;
				type = "passive";
			};

			battery_trip3: battery-trip3 {
				hysteresis = <0x3e8>;
				temperature = <0xb798>;
				type = "passive";
			};

			battery_trip4: battery-trip4 {
				hysteresis = <0x3e8>;
				temperature = <0xbb80>;
				type = "passive";
			};

			cx_trip: cx-trip {
				hysteresis = <0x1388>;
